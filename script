// DOM 요소 가져오기
const selectElement = document.getElementById("situation-select");
const recommendBtn = document.getElementById("recommend-btn");
const resultCard = document.getElementById("result-card");
const emojiDisplay = document.getElementById("emoji-display");
const outfitTitle = document.getElementById("outfit-title");
const outfitDesc = document.getElementById("outfit-desc");

// 버튼 클릭 이벤트 리스너
recommendBtn.addEventListener("click", () => {
    const selectedSituation = selectElement.value;
    const recommendation = outfitData[selectedSituation];

    if (recommendation) {
        // 데이터 채우기
        emojiDisplay.textContent = recommendation.emojis;
        outfitTitle.textContent = recommendation.title;
        outfitDesc.textContent = recommendation.desc;

        // 결과 카드 보이기
        resultCard.classList.remove("hidden");
    }
});